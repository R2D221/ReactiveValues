<UserControl
	x:Class="Signals_WpfSample.Views.ListsView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
	xmlns:local="clr-namespace:Signals_WpfSample.Views"
	xmlns:common="clr-namespace:ReactiveSamples.Common;assembly=ReactiveSamples.Common"
	mc:Ignorable="d" 
	d:DesignHeight="450" d:DesignWidth="800" d:Background="White">
	<UserControl.DataContext>
		<common:ListsViewModel/>
	</UserControl.DataContext>
	<Grid Margin="5">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*"/>
			<ColumnDefinition Width="Auto"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>

		<StackPanel Grid.Column="1">
			<Button Content="  →  " Margin="5" Command="{Binding MoveRightCommand}"/>
			<Button Content="  ←  " Margin="5" Command="{Binding MoveLeftCommand}"/>
		</StackPanel>

		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="*"/>
			</Grid.RowDefinitions>

			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>

				<TextBox Margin="5" Text="{Binding NewItem, UpdateSourceTrigger=PropertyChanged}"/>
				<Button Margin="5" Grid.Column="1" Content="  +  " Command="{Binding AddItemCommand}"/>
			</Grid>

			<ListBox Margin="5" Grid.Row="1" ItemsSource="{Binding LeftItems}" SelectedIndex="{Binding LeftIndex}"/>
		</Grid>

		<ListBox Margin="5" Grid.Column="2" ItemsSource="{Binding RightItems}" SelectedIndex="{Binding RightIndex}"/>
	</Grid>
</UserControl>
