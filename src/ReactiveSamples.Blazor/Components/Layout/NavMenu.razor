@using ReactiveSamples.Blazor.Components.Pages
<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">ReactiveSamples.Blazor</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="@Home.PageUri" Match="NavLinkMatch.All">
                <span class="bi-nav-menu">
                    <Blazicon Svg='BootstrapIcon.HouseDoorFill' />
                </span>
                Home
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="@Counter.PageUri">
                <span class="bi-nav-menu">
                    <Blazicon Svg='BootstrapIcon.PlusSquareFill' />
                </span>
                Counter
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="@InputControls.PageUri">
                <span class="bi-nav-menu">
                    <Blazicon Svg='BootstrapIcon.InputCursorText' />
                </span>
                Input controls
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="@Lists.PageUri">
                <span class="bi-nav-menu">
                    <Blazicon Svg='BootstrapIcon.ListCheck' />
                </span>
                Lists
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="@DataGrid.PageUri">
                <span class="bi-nav-menu">
                    <Blazicon Svg='BootstrapIcon.Grid3x3' />
                </span>
                Data grid
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="@RealTime.PageUri">
                <span class="bi-nav-menu">
                    <Blazicon Svg='BootstrapIcon.LightningFill' />
                </span>
                Real time
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="@Weather.PageUri">
                <span class="bi-nav-menu">
                    <Blazicon Svg='BootstrapIcon.CloudSunFill' />
                </span>
                Weather
            </NavLink>
        </div>
    </nav>
</div>

